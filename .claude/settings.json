{
  "worktree": {
    "baseRef": "head"
  },
  "extraKnownMarketplaces": {
    "agent-spec-flow": {
      "source": {
        "source": "github",
        "repo": "fryorcraken/agent-spec-flow"
      }
    }
  },
  "enabledPlugins": {
    "specflow@agent-spec-flow": true
  },
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh repo view *)",
      "Bash(gh release list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr status *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(gh run rerun *)",
      "Bash(gh api *)",
      "Bash(openspec *)",
      "Bash(grep *)",
      "Bash(pwd)",
      "Bash(lgs *)",
      "Bash(nix build *)",
      "Bash(qmltestrunner *)",
      "Bash(qmltestrunner6 *)",
      "Bash(/usr/lib64/qt6/bin/qmltestrunner *)",
      "Bash(sh radicle-ui/tests/*)",
      "Bash(cargo fmt *)",
      "Bash(cargo clippy *)",
      "Bash(cargo test *)",
      "Bash(cargo mutants *)"
    ],
    "deny": [
      "Bash(gh api *-X*)",
      "Bash(gh api *--method*)",
      "Bash(gh api * -f*)",
      "Bash(gh api -f*)",
      "Bash(gh api * -F*)",
      "Bash(gh api -F*)",
      "Bash(gh api *--field*)",
      "Bash(gh api *--raw-field*)",
      "Bash(gh api *--input*)"
    ]
  }
}
